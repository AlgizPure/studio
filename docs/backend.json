{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        }
      }
    },
    "Program": {
      "title": "Workout Program",
      "description": "A structured collection of workouts designed to achieve a specific fitness goal.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the program."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the program."
        },
        "isTemplate": {
          "type": "boolean",
          "description": "Whether this program is a template for others to use."
        },
        "authorId": {
          "type": "string",
          "description": "The ID of the user who created this program (if not a template)."
        }
      },
      "required": [
        "name"
      ]
    },
    "Workout": {
      "title": "Workout",
      "description": "A single workout session, which is part of a program and consists of multiple exercises.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the workout (e.g., 'Leg Day', 'Cardio Blast')."
        },
        "description": {
          "type": "string",
          "description": "A description of the workout."
        },
        "level": {
          "type": "number",
          "description": "The difficulty level of the workout."
        }
      },
      "required": [
        "name"
      ]
    },
    "Exercise": {
      "title": "Exercise",
      "description": "A single exercise activity.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the exercise."
        },
        "description": {
          "type": "string",
          "description": "A description of the exercise."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to the exercise category."
        },
        "authorId": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "format": "uri"
        },
        "custom": {
            "type": "boolean"
        },
        "time": {
            "type": "string"
        },
        "days": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
      },
      "required": [
        "name"
      ]
    },
    "WorkoutExercise": {
      "title": "Workout Exercise",
      "description": "Defines an exercise within a workout, including sets, reps, or duration.",
      "type": "object",
      "properties": {
        "exerciseId": {
          "$ref": "#/backend/entities/Exercise"
        },
        "sets": {
          "type": "number"
        },
        "reps": {
          "type": "number"
        },
        "duration": {
          "type": "string",
          "description": "Duration of the exercise (e.g., '30min', '5min cycle')."
        }
      }
    },
    "ProgramWorkout": {
      "title": "Program Workout",
      "description": "Links a workout to a program and defines its schedule.",
      "type": "object",
      "properties": {
        "workoutId": {
          "$ref": "#/backend/entities/Workout"
        },
        "schedule": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "repeating",
                "fixed_times"
              ]
            },
            "days": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repeatCount": {
              "type": "number"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "WorkoutLog": {
      "title": "Workout Log",
      "description": "A log of a completed workout session by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "programId": {
          "type": "string"
        },
        "workoutId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "completionPercentage": {
          "type": "number"
        },
        "completedExercises": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Habit": {
      "title": "Habit",
      "description": "A user's habit to track.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pomodoro": {
          "type": "object",
          "properties": {
            "cycles": {
              "type": "number"
            }
          }
        },
        "authorId": {
            "type": "string"
        },
        "completed": {
            "type": "boolean"
        }
      }
    },
    "HabitCategory": {
        "title": "Habit Category",
        "type": "object",
        "properties": {
            "name": {
                "type": "string"
            },
            "authorId": {
                "type": "string"
            }
        }
    },
    "ExerciseCategory": {
        "title": "Exercise Category",
        "type": "object",
        "properties": {
            "name": {
                "type": "string"
            },
            "authorId": {
                "type": "string"
            }
        }
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/programs": {
      "schema": {
        "$ref": "#/backend/entities/Program"
      },
      "description": "Collection of all workout programs, including templates."
    },
    "/programs/{programId}/workouts": {
      "schema": {
        "$ref": "#/backend/entities/ProgramWorkout"
      },
      "description": "Defines the workouts and their schedule within a program."
    },
    "/workouts/{workoutId}/exercises": {
      "schema": {
        "$ref": "#/backend/entities/WorkoutExercise"
      },
      "description": "The specific exercises that make up a workout."
    },
    "/users/{userId}/workoutLogs": {
      "schema": {
        "$ref": "#/backend/entities/WorkoutLog"
      },
      "description": "Logs of completed workouts for a user."
    },
    "/users/{userId}/habits": {
      "schema": {
        "$ref": "#/backend/entities/Habit"
      },
      "description": "Habits for a specific user."
    },
    "/users/{userId}/programs": {
      "schema": {
        "$ref": "#/backend/entities/Program"
      },
      "description": "Programs a user is currently participating in."
    },
    "/users/{userId}/exercises": {
        "schema": { "$ref": "#/backend/entities/Exercise" },
        "description": "Custom exercises created by a specific user."
    },
    "/users/{userId}/habitCategories": {
        "schema": { "$ref": "#/backend/entities/HabitCategory" },
        "description": "Custom habit categories for a user."
    },
    "/users/{userId}/exerciseCategories": {
        "schema": { "$ref": "#/backend/entities/ExerciseCategory" },
        "description": "Custom exercise categories for a user."
    }
  }
}
