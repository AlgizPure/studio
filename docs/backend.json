{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile with personal information and preferences.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        },
        "currentStreak": {
          "type": "number",
          "description": "The user's current consecutive day activity streak."
        },
        "lastActiveDate": {
          "type": "string",
          "description": "The last date the user completed an activity, in ISO format (YYYY-MM-DD)."
        }
      },
      "required": ["id", "email"]
    },
    "ExerciseCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ExerciseCategory",
      "type": "object",
      "description": "Represents a category for exercises.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the category."
        },
        "name": {
          "type": "string",
          "description": "Name of the category."
        },
        "authorId": {
          "type": "string",
          "description": "The ID of the user who created this category."
        }
      },
      "required": ["id", "name"]
    },
    "Exercise": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Exercise",
      "type": "object",
      "description": "Represents a single exercise that can be added to a workout or schedule.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Exercise entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the exercise."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to the ExerciseCategory."
        },
        "description": {
          "type": "string",
          "description": "Description of how to perform the exercise."
        },
        "image": {
          "type": "string",
          "description": "URL of an image demonstrating the exercise.",
          "format": "uri"
        },
        "custom": {
          "type": "boolean",
          "description": "Flag indicating if this is a custom exercise created by the user."
        },
        "time": {
          "type": "string",
          "description": "Scheduled time for the exercise (e.g., '08:00')."
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
          },
          "description": "Days of the week the exercise is scheduled for."
        },
        "authorId": {
          "type": "string",
          "description": "The ID of the user who created this exercise."
        },
        "lastCompleted": {
          "type": "string",
          "description": "The ISO date string of when the exercise was last completed.",
          "format": "date-time"
        },
        "distance": {
            "type": "number",
            "description": "Distance covered in kilometers, for cardio exercises."
        }
      },
      "required": ["id", "name", "categoryId", "description"]
    },
    "HabitCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HabitCategory",
      "type": "object",
      "description": "Represents a category for habits.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the category."
        },
        "name": {
          "type": "string",
          "description": "Name of the category."
        },
        "authorId": {
          "type": "string",
          "description": "The ID of the user who created this category."
        }
      },
      "required": ["id", "name"]
    },
    "Habit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Habit",
      "type": "object",
      "description": "Represents a habit that the user wants to track.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Habit entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the habit."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to the HabitCategory."
        },
        "goal": {
          "type": "string",
          "description": "A specific goal for the habit (e.g., '8 glasses', '15 minutes')."
        },
        "completed": {
          "type": "boolean",
          "description": "Indicates whether the habit was completed for the current period."
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
          },
          "description": "Days of the week the habit is active."
        },
        "pomodoro": {
          "type": "object",
          "properties": {
            "cycles": {
              "type": "number"
            }
          },
          "description": "Configuration for an associated Pomodoro timer."
        },
        "authorId": {
          "type": "string",
          "description": "The ID of the user who created this habit."
        }
      },
      "required": ["id", "name", "categoryId"]
    },
    "Program": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Program",
      "type": "object",
      "description": "A structured workout program, which can be a user-created program or a template.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isTemplate": { "type": "boolean" },
        "authorId": { "type": "string" }
      },
      "required": ["id", "name", "description", "isTemplate"]
    },
    "Workout": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Workout",
        "type": "object",
        "description": "A single workout session within a program, consisting of multiple exercises.",
        "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "level": { "type": "number" },
            "exercises": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "exerciseId": { "type": "string" },
                        "sets": { "type": "number" },
                        "reps": { "type": "number" },
                        "duration": { "type": "string" }
                    },
                    "required": ["exerciseId"]
                }
            }
        },
        "required": ["id", "name", "exercises"]
    },
    "ProgramWorkout": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ProgramWorkout",
        "type": "object",
        "description": "Links a Workout to a Program and defines its schedule within that program.",
        "properties": {
            "id": { "type": "string" },
            "workoutId": { "type": "string" },
            "schedule": {
                "type": "object",
                "properties": {
                    "type": { "type": "string", "enum": ["repeating", "fixed_times"] },
                    "days": { "type": "array", "items": { "type": "string" } },
                    "repeatCount": { "type": "number" },
                    "endDate": { "type": "string", "format": "date-time" }
                }
            }
        },
        "required": ["id", "workoutId", "schedule"]
    }
  },
  "auth": {
    "providers": [
      "google.com",
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profile data. Accessible only by the authenticated user. `userId` must match `request.auth.uid`."
        }
      },
      {
        "path": "/users/{userId}/exercises/{exerciseId}",
        "definition": {
            "entityName": "Exercise",
            "schema": { "$ref": "#/backend/entities/Exercise"},
            "description": "Stores custom exercises created by the user."
        }
      },
      {
        "path": "/users/{userId}/exerciseCategories/{categoryId}",
        "definition": {
            "entityName": "ExerciseCategory",
            "schema": { "$ref": "#/backend/entities/ExerciseCategory"},
            "description": "Stores user-defined categories for exercises."
        }
      },
      {
        "path": "/users/{userId}/habits/{habitId}",
        "definition": {
          "entityName": "Habit",
          "schema": {
            "$ref": "#/backend/entities/Habit"
          },
          "description": "Stores habits tracked by the user."
        }
      },
      {
        "path": "/users/{userId}/habitCategories/{categoryId}",
        "definition": {
            "entityName": "HabitCategory",
            "schema": { "$ref": "#/backend/entities/HabitCategory"},
            "description": "Stores user-defined categories for habits."
        }
      },
      {
        "path": "/programs/{programId}",
        "definition": {
            "entityName": "Program",
            "schema": { "$ref": "#/backend/entities/Program" },
            "description": "Stores program templates available to all users."
        }
      },
      {
        "path": "/users/{userId}/programs/{programId}",
        "definition": {
            "entityName": "Program",
            "schema": { "$ref": "#/backend/entities/Program" },
            "description": "Stores programs created by the user."
        }
      },
      {
        "path": "/users/{userId}/workouts/{workoutId}",
        "definition": {
            "entityName": "Workout",
            "schema": { "$ref": "#/backend/entities/Workout" },
            "description": "Stores workout sessions created by the user."
        }
      },
      {
        "path": "/users/{userId}/programs/{programId}/workouts/{programWorkoutId}",
        "definition": {
            "entityName": "ProgramWorkout",
            "schema": { "$ref": "#/backend/entities/ProgramWorkout" },
            "description": "Links a workout to a specific user program."
        }
      }
    ],
    "reasoning": "The Firestore data structure is designed to support Zenith Trainer's core features. It segregates user-specific data under a `/users/{userId}` path to secure it with path-based ownership rules (`request.auth.uid == userId`). Shared data, like program templates, resides in a global collection. This structure ensures data privacy, scalability, and efficient querying by keeping related data nested (e.g., workouts within a program) while allowing for flexible relationships (e.g., shared exercises)."
  }
}
