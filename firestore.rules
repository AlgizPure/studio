/**
 * @fileoverview Firestore Security Rules for Zenith Trainer application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Each user has full control over their profile and associated data (workout plans, scheduled workouts, habit trackers, habit items).
 *
 * Data Structure:
 * - /users/{userId}: User profile information. Root for all user-owned data.
 * - /users/{userId}/workoutPlans/{workoutPlanId}: Workout plans created by the user.
 * - /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}: Scheduled workouts within a workout plan.
 * - /exercises/{exerciseId}: Publicly readable exercises.
 * - /users/{userId}/habitTrackers/{habitTrackerId}: Habit trackers for each user.
 * - /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}: Individual habit items within a habit tracker.
 *
 * Key Security Decisions:
 * - User data is isolated under the /users/{userId} path.
 * - All data nested under a user's profile is accessible only to that user (ownership model).
 * - Exercises are publicly readable, but write access is not granted in this ruleset.
 *
 * Denormalization for Authorization:
 * - The userId is denormalized (copied) into WorkoutPlan, ScheduledWorkout, HabitTracker, and HabitItem documents.
 *   This allows rules to quickly verify ownership without needing to perform additional `get()` operations.
 *
 * Structural Segregation:
 * - Public exercises are stored in a top-level collection (/exercises/{exerciseId}), separate from user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile information. Only the user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create, get, update, delete, list) if the user's UID matches the userId in the path.
     * @deny (create) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects workout plans. Only the owning user can read, write, and delete their workout plans.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}
     * @allow (create, get, update, delete, list) if the user's UID matches the userId in the path.
     * @deny (create) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects scheduled workouts. Only the owning user can read, write, and delete their scheduled workouts.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}
     * @allow (create, get, update, delete, list) if the user's UID matches the userId in the path.
     * @deny (create) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to exercises. Write access is not granted.
     * @path /exercises/{exerciseId}
     * @allow (get, list) to all users.
     * @deny (create, update, delete) to all users.
     * @principle Allows public read access while restricting write access.
     */
    match /exercises/{exerciseId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Protects habit trackers. Only the owning user can read, write, and delete their habit trackers.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}
     * @allow (create, get, update, delete, list) if the user's UID matches the userId in the path.
     * @deny (create) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects habit items. Only the owning user can read, write, and delete their habit items.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}
     * @allow (create, get, update, delete, list) if the user's UID matches the userId in the path.
     * @deny (create) if the user's UID does not match the userId in the path.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}