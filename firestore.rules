/**
 * @fileoverview Firestore Security Rules for Zenith Trainer Application
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data
 * while allowing public read access to shared resources. Data consistency is enforced
 * through validation of key fields on write operations.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, the root of all user-owned data.
 * - /users/{userId}/workoutPlans/{workoutPlanId}: Workout plans for each user.
 * - /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}: Scheduled workouts within workout plans.
 * - /exercises/{exerciseId}: Publicly readable exercises.
 * - /users/{userId}/habitTrackers/{habitTrackerId}: Habit trackers for each user.
 * - /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}: Habit items within habit trackers.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to the /exercises collection.
 * - Helper functions are used to encapsulate complex logic and ensure code reusability.
 * - Data denormalization is used to simplify authorization checks and improve performance.
 *
 * Denormalization for Authorization:
 * - WorkoutPlan documents contain a 'userId' field, mirroring the parent path, to simplify
 *   ownership checks without requiring a 'get()' operation to the parent /users/{userId} document.
 * - ScheduledWorkout documents contain a 'userId' field for the same reason.
 * - HabitTracker documents contain a 'userId' field for the same reason.
 * - HabitItem documents contain a 'userId' field for the same reason.
 *
 * Structural Segregation:
 * - Publicly available exercises are stored in the top-level /exercises collection, separate from
 *   user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Allows users to manage their own profile.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their profile. request.auth.uid == 'user123'
     * @allow (get) - User with ID 'user123' can read their profile. request.auth.uid == 'user123'
     * @allow (update) - User with ID 'user123' can update their profile. request.auth.uid == 'user123'
     * @allow (delete) - User with ID 'user123' can delete their profile. request.auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a profile for 'user123'. request.auth.uid == 'user456'
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their workout plans.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}
     * @allow (create) - User with ID 'user123' can create a workout plan. request.auth.uid == 'user123'
     * @allow (get) - User with ID 'user123' can read their workout plan. request.auth.uid == 'user123'
     * @allow (update) - User with ID 'user123' can update their workout plan. request.auth.uid == 'user123'
     * @allow (delete) - User with ID 'user123' can delete their workout plan. request.auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a workout plan for 'user123'. request.auth.uid == 'user456'
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their scheduled workouts.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}
     * @allow (create) - User with ID 'user123' can create a scheduled workout. request.auth.uid == 'user123'
     * @allow (get) - User with ID 'user123' can read their scheduled workout. request.auth.uid == 'user123'
     * @allow (update) - User with ID 'user123' can update their scheduled workout. request.auth.uid == 'user123'
     * @allow (delete) - User with ID 'user123' can delete their scheduled workout. request.auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a scheduled workout for 'user123'. request.auth.uid == 'user456'
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read exercises, but only allows authenticated users to create, update, and delete them.
     * @path /exercises/{exerciseId}
     * @allow (get, list) - Any user can read exercises.
     * @allow (create) - Authenticated user can create an exercise.
     * @allow (update) - Authenticated user can update an existing exercise.
     * @allow (delete) - Authenticated user can delete an existing exercise.
     * @deny (create) - Unauthenticated user cannot create an exercise.
     * @principle Allows public read access while restricting write access to authenticated users.
     */
    match /exercises/{exerciseId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows users to manage their habit trackers.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}
     * @allow (create) - User with ID 'user123' can create a habit tracker. request.auth.uid == 'user123'
     * @allow (get) - User with ID 'user123' can read their habit tracker. request.auth.uid == 'user123'
     * @allow (update) - User with ID 'user123' can update their habit tracker. request.auth.uid == 'user123'
     * @allow (delete) - User with ID 'user123' can delete their habit tracker. request.auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a habit tracker for 'user123'. request.auth.uid == 'user456'
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their habit items.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}
     * @allow (create) - User with ID 'user123' can create a habit item. request.auth.uid == 'user123'
     * @allow (get) - User with ID 'user123' can read their habit item. request.auth.uid == 'user123'
     * @allow (update) - User with ID 'user123' can update their habit item. request.auth.uid == 'user123'
     * @allow (delete) - User with ID 'user123' can delete their habit item. request.auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a habit item for 'user123'. request.auth.uid == 'user456'
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}