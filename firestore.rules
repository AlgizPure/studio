/**
 * @fileoverview Firestore Security Rules for Zenith Trainer application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Each user has full control over their profile and associated data (workout plans, scheduled workouts, habit trackers, habit items). Exercises are publicly readable but not writable except for future admin users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Root path for all user-owned data.
 * - /users/{userId}/workoutPlans/{workoutPlanId}: Stores workout plans created by the user.
 * - /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}: Stores scheduled workouts within a workout plan.
 * - /exercises/{exerciseId}: Stores exercises. Publicly readable.
 * - /users/{userId}/habitTrackers/{habitTrackerId}: Stores habit trackers for each user.
 * - /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}: Stores individual habit items within a habit tracker.
 *
 * Key Security Decisions:
 * - User data is strictly segregated by UID.
 * - Listing other user's collections is disallowed.
 * - Exercises are publicly readable.
 *
 * Denormalization for Authorization:
 * - WorkoutPlans, ScheduledWorkouts, HabitTrackers, and HabitItems are stored as subcollections of the user's document to simplify security rules and avoid complex `get()` calls. This allows for efficient path-based authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     * @param {string} userId - The user ID to compare against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description User profile information. Root path for all user-owned data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates their profile with id: 'user123'.
     * @deny (create) User with UID 'user123' attempts to create a profile with id: 'user456'.
     * @allow (get) User with UID 'user123' reads their own profile.
     * @deny (get) User with UID 'user123' attempts to read profile of 'user456'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores workout plans created by the user. Includes denormalized 'userId' for authorization independence.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}
     * @allow (create) User with UID 'user123' creates a workout plan under their user ID.
     * @deny (create) User with UID 'user123' attempts to create a workout plan under user ID 'user456'.
     * @allow (get) User with UID 'user123' reads their own workout plan.
     * @deny (get) User with UID 'user123' attempts to read workout plan of 'user456'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores scheduled workouts within a workout plan. Includes denormalized 'userId' for authorization independence.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}
     * @allow (create) User with UID 'user123' creates a scheduled workout under their workout plan.
     * @deny (create) User with UID 'user123' attempts to create a scheduled workout under user ID 'user456'.
     * @allow (get) User with UID 'user123' reads their own scheduled workout.
     * @deny (get) User with UID 'user123' attempts to read scheduled workout of 'user456'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores exercises. All users have read access.
     * @path /exercises/{exerciseId}
     * @allow (get) Any user can read any exercise.
     * @deny (create) No user can create a new exercise.
     * @principle Public read access with restricted writes.
     */
    match /exercises/{exerciseId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores habit trackers for each user. Includes denormalized 'userId' for authorization independence.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}
     * @allow (create) User with UID 'user123' creates a habit tracker under their user ID.
     * @deny (create) User with UID 'user123' attempts to create a habit tracker under user ID 'user456'.
     * @allow (get) User with UID 'user123' reads their own habit tracker.
     * @deny (get) User with UID 'user123' attempts to read habit tracker of 'user456'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores individual habit items within a habit tracker. Includes denormalized 'userId' for authorization independence.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}
     * @allow (create) User with UID 'user123' creates a habit item under their habit tracker.
     * @deny (create) User with UID 'user123' attempts to create a habit item under user ID 'user456'.
     * @allow (get) User with UID 'user123' reads their own habit item.
     * @deny (get) User with UID 'user123' attempts to read habit item of 'user456'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}