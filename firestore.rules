/**
 * @fileoverview Firestore Security Rules for Zenith Trainer application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  A user can only
 * access data associated with their own user ID.  This is achieved through
 * path-based rules (e.g., /users/{userId}/...) and denormalized `userId`
 * fields within documents.
 *
 * Data Structure:
 * The data is organized hierarchically under the `/users/{userId}` path.
 * Each user has their own WorkoutPlans, ScheduledWorkouts, HabitTrackers,
 * and HabitItems stored as subcollections. The /exercises collection is
 * globally readable but only writeable by authenticated users who provide
 * the correct author id.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect privacy.
 * - The /exercises collection is publicly readable.
 * - All write operations are strictly controlled based on user ownership.
 *
 * Denormalization for Authorization:
 * The `userId` field is denormalized into WorkoutPlan, ScheduledWorkout,
 * HabitTracker, and HabitItem documents. This avoids the need for complex
 * `get()` calls to verify ownership, resulting in simpler and more
 * performant security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Root match for all documents in the database. This is required by the rules syntax.
     * @path /databases/{database}/documents
     * @allow (get, list, create, update, delete): Never applies directly. Sub-rules handle access control.
     * @deny (get, list, create, update, delete): Always applies directly. Access is controlled by sub-rules.
     * @principle Root path, access is delegated to child paths.
     */
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Manages user profile data. Only the authenticated user can read and write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId);
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // User listing is not permitted.

      // Allow the user to create their own profile, but enforce that the user ID in the
      // document matches the authenticated user's ID.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // For updates, ensure the user is signed in, is the owner, and that the user ID
      // in the updated document still matches the authenticated user's ID to avoid
      // ownership changes.
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;

      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages workout plans for a specific user. Only the owner can read and write workout plans.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId);
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages scheduled workouts within a workout plan for a user. Only the owner can read and write scheduled workouts.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId);
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages exercises. All users can read exercises; only authenticated users can create, update, and delete them.
     * @path /exercises/{exerciseId}
     * @allow (get, list): if true;
     * @allow (create, update, delete): if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (create, update, delete): if !isSignedIn();
     * @principle Allows public read access with authenticated-user-only writes.
     */
    match /exercises/{exerciseId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if isSignedIn() && false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if isSignedIn() && false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages habit trackers for a specific user. Only the owner can read and write habit trackers.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId);
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages habit items within a habit tracker for a user. Only the owner can read and write habit items.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}
     * @allow (get, create, update, delete, list): if isSignedIn() && isOwner(userId);
     * @deny (get, create, update, delete, list): if !isSignedIn() || !isOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages exercise categories for a user. Only the owner can read exercise categories.
     * @path /users/{userId}/exerciseCategories/{exerciseCategoryId}
     */
    match /users/{userId}/exerciseCategories/{exerciseCategoryId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the resource.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  // Helper function to check if the user is the owner of an existing resource.
  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}