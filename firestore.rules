rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId);
    }

    /**
     * @description Rule for all documents.  Default deny to prevent accidental open access.
     */
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @deny (create) User with ID 'user123' cannot create a profile with a different ID ('user456').
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed for privacy.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId); //Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages workout plan documents within a user's profile.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}
     * @allow (create) User with ID 'user123' can create a workout plan under their profile.
     * @deny (update) User with ID 'user123' cannot update a workout plan under another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId); //Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages scheduled workout documents within a workout plan.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId}
     * @allow (create) User with ID 'user123' can create a scheduled workout under their workout plan.
     * @deny (update) User with ID 'user123' cannot update a scheduled workout under another user's workout plan.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId}/scheduledWorkouts/{scheduledWorkoutId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages exercise documents.
     * @path /exercises/{exerciseId}
     * @allow (get) Any user can read an exercise.
     * @allow (list) Any user can list exercises.
     * @deny (create) No user can create an exercise.
     * @principle Allows public read access but restricts writes.
     */
    match /exercises/{exerciseId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
     * @description Manages exercises subcollection within a user's profile.
     * @path /users/{userId}/exercises/{exerciseId}
     * @allow (get) User can read an exercise.
     * @allow (list) User can list exercises.
     * @deny (create) No user can create an exercise.
     * @principle Allows public read access but restricts writes.
     */
    match /users/{userId}/exercises/{exerciseId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages habit tracker documents within a user's profile.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}
     * @allow (create) User with ID 'user123' can create a habit tracker under their profile.
     * @deny (update) User with ID 'user123' cannot update a habit tracker under another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId); //Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages habit item documents within a habit tracker.
     * @path /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId}
     * @allow (create) User with ID 'user123' can create a habit item under their habit tracker.
     * @deny (update) User with ID 'user123' cannot update a habit item under another user's habit tracker.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/habitTrackers/{habitTrackerId}/habitItems/{habitItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}