# Firebase Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side)
# For local development, download service account key from Firebase Console
# Project Settings > Service Accounts > Generate new private key
# Store the JSON file securely and reference the path here
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=./path/to/serviceAccountKey.json

# Google AI (Genkit)
# Get API key from https://makersuite.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here

# Playwright Testing (Optional)
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:9002

# Note: After filling in the values, copy this file to .env.local
# cp .env.example .env.local
# Never commit .env.local to version control!
